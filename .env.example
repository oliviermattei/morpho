# Neon Postgres — server-side only. Never prefix with NEXT_PUBLIC_.
DATABASE_URL=

# Neon Auth — server-side only.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Playwright: set to run e2e against a deployed preview instead of a local dev
# server. Leave empty locally.
E2E_BASE_URL=

# Playwright: credentials of a real account on the Neon Auth project. When
# both are set, `npm run test:e2e` also runs the session-dependent specs
# (*.auth.spec.ts) against a session opened for real. Leave empty to run the
# anonymous suite only. Never a production account — these specs sign out.
E2E_EMAIL=
E2E_PASSWORD=
