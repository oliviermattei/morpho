{
  "name": "morpho",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted PWA to track weight and body measurements — body map, deltas since day one, charts.",
  "license": "MIT",
  "author": "Olivier Mattei",
  "homepage": "https://github.com/oliviermattei/morpho#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oliviermattei/morpho.git"
  },
  "bugs": {
    "url": "https://github.com/oliviermattei/morpho/issues"
  },
  "keywords": [
    "pwa",
    "nextjs",
    "health",
    "body-measurements",
    "weight-tracker",
    "self-hosted",
    "drizzle",
    "neon"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:pwa": "E2E_PROD=1 playwright test tests/e2e/pwa-offline.spec.ts --project=desktop",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "check": "npm run typecheck && npm run lint && npm run test",
    "check:leak": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --config vitest.leak.config.mts"
  },
  "dependencies": {
    "@neondatabase/auth": "^0.4.2-beta",
    "@neondatabase/serverless": "^1.1.0",
    "@serwist/turbopack": "9.5.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "recharts": "^3.8.0",
    "serwist": "9.5.12",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
